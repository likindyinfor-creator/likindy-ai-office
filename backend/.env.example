APP_NAME=LikindyAIOffice
APP_ENV=production
APP_KEY=GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=YOUR_RENDER_BACKEND_ORIGIN
FRONTEND_URL=YOUR_VERCEL_FRONTEND_ORIGIN
FRONTEND_ORIGINS=YOUR_VERCEL_FRONTEND_ORIGIN
WORKSPACE_INVITATION_EXPIRATION_DAYS=7
DOCUMENT_DELETED_RETENTION_DAYS=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=YOUR_SUPABASE_DATABASE_HOST
DB_PORT=5432
DB_DATABASE=YOUR_SUPABASE_DATABASE_NAME
DB_USERNAME=YOUR_SUPABASE_DATABASE_USER
DB_PASSWORD=YOUR_SUPABASE_DATABASE_PASSWORD
DB_SSLMODE=require

SANCTUM_STATEFUL_DOMAINS=YOUR_VERCEL_HOST

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Trust Render's ingress only; accepted forwarded headers are limited in bootstrap/app.php.
TRUSTED_PROXIES=*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENT_ATTACHMENTS_DISK=r2
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_REGION=auto
R2_BUCKET=YOUR_PRIVATE_R2_BUCKET
R2_ENDPOINT=YOUR_CLOUDFLARE_R2_ENDPOINT
R2_USE_PATH_STYLE_ENDPOINT=true
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=YOUR_SMTP_HOST
MAIL_PORT=YOUR_SMTP_PORT
MAIL_USERNAME=YOUR_SMTP_USERNAME
MAIL_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM_ADDRESS=YOUR_VERIFIED_SENDER_ADDRESS
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
